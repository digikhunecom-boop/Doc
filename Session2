}

fun main() = runBlocking {
    val t = System.currentTimeMillis()
    val a = async { work("A", 1000) }
    val b = async(start = CoroutineStart.LAZY) { work("B", 500) }
    println(a.await())
    println(b.await())
    println(System.currentTimeMillis() - t)
}
