package ir.sadadpsp.apos.repo.switches.functioncodes;

import java.nio.charset.StandardCharsets;
import java.util.Locale;

/** Paper roll usage — طول کاغذ مصرف‌شده بر حسب سانتی‌متر. نمونه: 059006999999 */
public class ClientFunctionCode59 extends ClientFunctionCodeBase {

    public static final String CODE = "059";
    private static final int DATA_LEN = 6;
    public static final long MAX_CM = 999_999L;

    @Override
    public String get(byte[] data) {
        if (data == null || data.length == 0) return CODE + "000";
        String s = new String(data, StandardCharsets.UTF_8);
        return CODE + String.format(Locale.US, "%03d", s.length()) + s;
    }

    @Override
    public <T> String get(T data) {
        return "";
    }

    /** 123 → بایت‌های "000123" */
    public static byte[] payload(long lengthCm) {
        long v = Math.max(0, Math.min(lengthCm, MAX_CM));
        return String.format(Locale.US, "%0" + DATA_LEN + "d", v)
                .getBytes(StandardCharsets.UTF_8);
    }
}



